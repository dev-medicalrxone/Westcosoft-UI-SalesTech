unit UntThirdParty;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms, Dialogs,
  Buttons, Grids, DBGrids, DBCtrls, ExtCtrls, DB, StdCtrls, Mask, DBCGrids,
  ToolWin, ComCtrls;

type
  TFrmThirdParty = class(TForm)
    Panel1: TPanel;
    ScrollBox1: TScrollBox;
    Label1: TLabel;
    DBEdit1: TDBEdit;
    Label12: TLabel;
    DBEdit12: TDBEdit;
    Label6: TLabel;
    DBEdit6: TDBEdit;
    DBComboBox1: TDBComboBox;
    Label5: TLabel;
    DBEdit4: TDBEdit;
    Label4: TLabel;
    DBEdit7: TDBEdit;
    Label7: TLabel;
    DBEdit3: TDBEdit;
    Label3: TLabel;
    DBEdit2: TDBEdit;
    Label2: TLabel;
    DBComboBox2: TDBComboBox;
    Label8: TLabel;
    DBEdit9: TDBEdit;
    Label9: TLabel;
    DBEdit10: TDBEdit;
    Label10: TLabel;
    DBComboBox3: TDBComboBox;
    Label11: TLabel;
    CoolBar1: TCoolBar;
    ToolBar1: TToolBar;
    DBNavigator1: TDBNavigator;
    Panel2: TPanel;
    DBGrid1: TDBGrid;
    procedure FormCloseQuery(Sender: TObject; var CanClose: Boolean);
    procedure FormKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure FormCreate(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FrmThirdParty: TFrmThirdParty;

implementation

uses UntData, UntCommon;

{$R *.DFM}

procedure TFrmThirdParty.FormCloseQuery(Sender: TObject;
  var CanClose: Boolean);
begin
  CanClose := True;
  If Not (DtMdlData.TPlanes.State = dsBrowse) then
  Begin
    ShowMessage('Favor de guardar los cambios antes de salir');
    CanClose := False;
  end
end;

procedure TFrmThirdParty.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  ScreenRoutine.FormKeys(Self, DtMdlData.TPlanes, Key, Shift);
end;

procedure TFrmThirdParty.FormKeyPress(Sender: TObject; var Key: Char);
begin
  ScreenRoutine.Enter2Tab(Self, Key);
end;



procedure TFrmThirdParty.FormCreate(Sender: TObject);
begin
  FormActive.FormFormThirdParty := True;
end;

procedure TFrmThirdParty.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
    FormActive.FormFormThirdParty := True;
    Action := caFree;
end;

end.
